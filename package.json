{
  "name": "clarityone",
  "version": "0.1.0",
  "private": true,
  "description": "A lightweight browser accessibility extension for improving contrast, text readability, and keyboard focus.",
  "scripts": {
    "build": "bash scripts/build.sh all",
    "build:all": "bash scripts/build.sh all",
    "build:chrome": "bash scripts/build.sh chrome",
    "build:safari": "bash scripts/build.sh safari",
    "build:chrome-tester": "bash scripts/package-chrome-tester.sh",
    "build:test-release": "bash scripts/release-test-build.sh",
    "release:validate": "bash scripts/validate-release-package.sh",
    "safari:convert": "bash scripts/safari-convert.sh",
    "safari:preflight": "bash scripts/safari-convert.sh --preflight",
    "test": "node tests/background.test.mjs",
    "test:e2e": "npx playwright test",
    "test:all": "bash scripts/test-all.sh",
    "test:ci": "npm run build && npm test && npm run release:validate",
    "capture:social": "node scripts/capture-from-config.js --config capture-config.json",
    "capture:site": "node scripts/capture-from-config.js --config capture-config.json",
    "capture:install": "npx playwright install chromium"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.50.0"
  }
}
